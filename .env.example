# Copy to .env and fill in real values.
APP_MODE=fullstack          # fullstack | api
SECRET_KEY=replace-with-a-long-random-string
UPLOAD_PASSWORD=replace-me
MAX_UPLOAD_MB=100           # max total size of one upload request
DEFAULT_LANG=fi            # fi | en — initial UI language (visitors can toggle)
BEHIND_PROXY=0             # set to 1 in production when running behind Caddy/nginx

STORAGE_BACKEND=local
# S3_ENDPOINT=
# S3_BUCKET=
# S3_ACCESS_KEY=
# S3_SECRET_KEY=
# S3_PUBLIC_BASE=
# S3_REGION=
