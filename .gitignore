# --- Python ---
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
build/
dist/

# --- Virtual environments ---
.venv/
venv/
env/
ENV/

# --- Secrets / local config (keep .env.example tracked) ---
.env
.env.*
!.env.example

# --- Flask instance folder (holds the SQLite database) ---
instance/

# --- User-uploaded media (created at runtime) ---
media/

# --- Babel translation template (regenerated by `pybabel extract`) ---
messages.pot

# --- Tooling caches ---
.pytest_cache/
.mypy_cache/
.ruff_cache/
.cache/
.coverage
htmlcov/

# --- Claude Code local-only settings ---
.claude/settings.local.json

# --- Editors / IDEs ---
.vscode/
.idea/
*.swp
*~

# --- OS cruft ---
.DS_Store
Thumbs.db
